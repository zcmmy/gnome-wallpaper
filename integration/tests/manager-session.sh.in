#!/bin/bash
set -euo pipefail
root="$(cd "$(dirname "$0")/../.." && pwd)"
export WALLPAPER_TEST_ROOT="$root"
export XDG_CONFIG_HOME="$root/runtime/manager-test/config"
export XDG_DATA_HOME="$root/runtime/manager-test/data"
export XDG_CACHE_HOME="$root/runtime/manager-test/cache"
export XDG_STATE_HOME="$root/runtime/manager-test/state"
export XDG_RUNTIME_DIR="$root/runtime/manager-test/run"
mkdir -p "$XDG_RUNTIME_DIR" "$XDG_CONFIG_HOME" "$XDG_CACHE_HOME" "$XDG_STATE_HOME"
chmod 700 "$XDG_RUNTIME_DIR"
export GIO_USE_VFS=local GVFS_DISABLE_FUSE=1
unset DISPLAY
export WAYLAND_DISPLAY=wallpaper-manager-test
export GSETTINGS_SCHEMA_DIR="$XDG_DATA_HOME/gnome-shell/extensions/wallpaperengine@waylandwe/schemas"
glib-compile-schemas "$GSETTINGS_SCHEMA_DIR"
exec dbus-run-session -- bash -c '
printf "%s" "$DBUS_SESSION_BUS_ADDRESS" > "$WALLPAPER_TEST_ROOT/runtime/manager-test/bus-address"
s=org.gnome.shell.extensions.wallpaperengine
gsettings reset-recursively "$s"
gsettings set "$s" library-root "$WALLPAPER_TEST_ROOT/runtime/manager-test/wallpapers"
gsettings set "$s" assets-path "$WALLPAPER_TEST_ROOT/assets"
gsettings set "$s" wallpaperengine-path "$WALLPAPER_TEST_ROOT/renderer/scripts/run.sh"
gsettings set org.gnome.shell enabled-extensions "[\"wallpaperengine@waylandwe\"]"
gsettings set org.gnome.shell disable-user-extensions false
gsettings set org.gnome.shell welcome-dialog-last-shown-version "48.0"
exec gnome-shell --headless --virtual-monitor=1280x720 --wayland --wayland-display wallpaper-manager-test --no-x11 --sm-disable
'
